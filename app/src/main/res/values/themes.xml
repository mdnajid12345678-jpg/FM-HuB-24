<resources>
    <style name="Theme.FMHuB24" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2F78EE</item>
        <item name="android:statusBarColor">#05052B</item>
        <item name="android:navigationBarColor">#05052B</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.FMHuB24.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fmhub_splash_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fmhub_mark</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.FMHuB24</item>
    </style>
</resources>
